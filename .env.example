# Shared
APP_ENV=development

# API
APP_NAME=AFDP API
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afdp
DATABASE_MIN_POOL_SIZE=1
DATABASE_MAX_POOL_SIZE=10
REDIS_URL=redis://redis:6379/0
SEARCH_CACHE_TTL_SECONDS=300
ADMIN_API_KEY=your-secret-admin-key-here
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Transactional email (password reset) over SMTP, e.g. Gmail.
# Leave SMTP_USER/SMTP_PASSWORD empty in development to log emails to the API
# console instead of sending them.
# For Gmail: enable 2-Step Verification, then create an App Password
# (https://myaccount.google.com/apppasswords) and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# From header; defaults to SMTP_USER when empty. Gmail requires this to match
# the authenticated account.
EMAIL_FROM=AFDP <your-account@gmail.com>
# Public URL of the web app, used to build links inside emails.
FRONTEND_BASE_URL=http://localhost:3000

NEON_DATABASE_URL=
UPSTASH_REDIS_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAPBOX_ACCESS_TOKEN=

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAPBOX_TOKEN=

# Docker/Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=afdp
POSTGRES_PORT=5432
REDIS_PORT=6379
